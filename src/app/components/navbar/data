import { useState } from 'react';
// import ComplianceDashboard from './ComplianceDashboard/KycDashboard';

import BusinessComplianceTable from './BusinessCompliance/BusinessComplianceTables';
import IndividualComplianceTable from './IndividualCompliance/IndividualComplianceTable';
import SuspiciousActivityPage from './Sars/SarsPage';

const KycAndAmlLayout = () => {
  const tabs = [
    // { label: 'Compliance Dashboard', value: 'dashboard' },
    { label: 'Individual', value: 'individual' },
    { label: 'Business', value: 'business' },
    // { label: 'Transaction', value: 'transaction' },
    { label: 'SARS', value: 'sars' },

    // { label: "Integration", value: "integration" },
  ];

  const [activeTab, setActiveTab] = useState('individual');

  return (
    <div>
      <div className="flex w-full border-b mb-4">
        {tabs.map((tab) => {
          const isActive = activeTab === tab.value;
          return (
            <button
              key={tab.value}
              onClick={() => setActiveTab(tab.value)}
              className={`font-nonbureau px-4 py-2 text-14 font-medium transition-all duration-200 border-b-2 text-center ${
                isActive
                  ? 'text-black font-bold border-primary'
                  : 'text-neutralGrey font-[300] hover:bg-gray-100 border-transparent'
              }`}
            >
              {tab.label}
            </button>
          );
        })}
      </div>

      {/* Content */}
      <div className="mt-4">
        {/* {activeTab === 'dashboard' && <ComplianceDashboard />} */}
        {activeTab === 'individual' && <IndividualComplianceTable />}
        {activeTab === 'business' && <BusinessComplianceTable />}
        {activeTab === 'sars' && <SuspiciousActivityPage />}
      </div>
    </div>
  );
};

export default KycAndAmlLayout;
